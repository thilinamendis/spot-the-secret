rules_version = '2';

// Spot the Secret leaderboard rules. Paste into Firebase console >
// Firestore Database > Rules, then Publish.
//
// Anyone can read the boards and add one well-formed score. Nobody can
// change or delete a score from the game; a teacher clears a board from the
// Firebase console (or simply starts a new one with ?board=newname).
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{board}/scores/{scoreId} {
      allow read: if board.matches('^[a-z0-9_-]{1,32}$');

      allow create: if board.matches('^[a-z0-9_-]{1,32}$')
        && request.resource.data.keys().hasOnly(['name', 'score', 'found', 'avgMs', 'bestStreak', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'score', 'found', 'avgMs', 'bestStreak', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Za-z0-9 _-]{1,16}$')
        // 118 = 10 levels x 10 points + 9 x 2 streak bonus (MAX_SCORE in leaderboard.js)
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 118
        && request.resource.data.found is int
        && request.resource.data.found >= 0 && request.resource.data.found <= 10
        && request.resource.data.bestStreak is int
        && request.resource.data.bestStreak >= 0 && request.resource.data.bestStreak <= 10
        && request.resource.data.avgMs is number
        && request.resource.data.avgMs >= 0 && request.resource.data.avgMs <= 60000
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
